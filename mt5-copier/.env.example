# MT5 Trade Copier - environment template. Copy to .env and fill in.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Must equal MT5_COPIER_SECRET in the web app's .env.
COPIER_SECRET=

# Where the copier listens. The web app reaches it over loopback only; never expose it.
COPIER_HOST=127.0.0.1
COPIER_PORT=8766

# mt5-connector, used to read master accounts over the Manager API.
# CONNECTOR_SECRET must equal MT5_CONNECTOR_SECRET in the web app's .env.
CONNECTOR_URL=http://127.0.0.1:8765
CONNECTOR_SECRET=

# One portable MT5 terminal is provisioned per destination account (~230 MB each).
TERMINALS_ROOT=C:\mt5-terminals

# Seconds between reconciliation cycles. Lower copies faster and polls the broker harder.
POLL_INTERVAL=1.0
