# Python connector: virtualenv, caches, and the MT5 Manager SDK's local cache (regenerated on connect)
mt5-connector/.venv/
mt5-connector/bases/
mt5-connector/logs/
__pycache__/
*.pyc
.pytest_cache/

# NOTE: .env files and data/ (brokers, users, telegram, encryption.key, monitored) ARE committed on
# purpose: this is a private repo used as the deployment source of truth. Keep the repo private.
# Runtime-only state is excluded: alert history + position snapshots regenerate (fresh baseline
# on a new server avoids stale-snapshot alert floods) and change every few seconds.
data/notifications.json
data/audit.json

# Trade copier runtime state (ticket maps) and its virtualenv
mt5-copier/state/
mt5-copier/.venv/
mt5-copier/.env

# Portable MT5 terminals must never live inside the repository
mt5-terminals/

# Per-machine runtime state: where Telegram delivery has got to
data/copier-alert-cursor.json
