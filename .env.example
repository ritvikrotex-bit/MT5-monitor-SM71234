# MT5 Monitor - environment template. Copy to .env and fill in.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MT5 connector (Python service, loopback only). MT5_CONNECTOR_SECRET must equal
# CONNECTOR_SECRET in mt5-connector/.env.
MT5_CONNECTOR_URL=http://127.0.0.1:8765
MT5_CONNECTOR_SECRET=

# Trade copier (optional, Python service, loopback only). MT5_COPIER_SECRET must equal
# COPIER_SECRET in mt5-copier/.env. Leave MT5_COPIER_SECRET unset if you are not copying trades:
# the Copier page then reports the service as unreachable and nothing is copied.
# The copier reads master accounts through the connector above, so mt5-copier/.env also needs
# CONNECTOR_SECRET set to the same value as MT5_CONNECTOR_SECRET.
MT5_COPIER_URL=http://127.0.0.1:8766
# MT5_COPIER_SECRET=

# Signs the login session cookie. Use a fresh random 64-hex value per deployment.
MONITOR_SESSION_SECRET=

# Accounts live in data/users.json (scrypt-hashed passwords). Manage them with:
#   npm run users -- list | add | set-password | set-role | set-status
# Only for a brand-new install with no admin yet: the first start creates this admin.
# There is NO built-in default admin; without these (and without an ADMIN in users.json)
# nobody can administer the system.
# INITIAL_ADMIN_NAME=Administrator
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# Optional PostgreSQL mirror of users/brokers/monitored clients/audit log. Leave unset to use
# the JSON files in data/ only (recommended for a small team). See DEPLOYMENT.md.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/mt5_monitor

# Seconds between MT5 position polls per monitored client (1-300). 5 is a sensible default.
MONITOR_POLL_INTERVAL_SECONDS=5

# Web server bind address/port (Caddy proxies to this; never expose directly)
HOST=127.0.0.1
PORT=3000

# Where brokers/users/alerts/encryption.key are stored. Defaults to <project>/data.
# DATA_DIR=C:\apps\mt5-monitor\data

# Telegram is PER USER: each account pastes its own bot token and chat ID under Settings > Telegram, and
# alerts for that account's monitored clients go only to that chat (stored encrypted in data/telegram.json).
# There are no global TELEGRAM_* variables. TELEGRAM_API_BASE exists only so tests can use a local fake.
# TELEGRAM_API_BASE=https://api.telegram.org
# Only needed to trigger polls externally via POST /api/alerts/poll (header X-Monitor-Poll-Secret)
# MONITOR_POLL_SECRET=
