# MT5 Trade Monitor - environment template. Copy to .env and fill in.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MT5 connector (Python service, loopback only). MT5_CONNECTOR_SECRET must equal
# CONNECTOR_SECRET in mt5-connector/.env.
MT5_CONNECTOR_URL=http://127.0.0.1:8765
MT5_CONNECTOR_SECRET=

# Signs the login session cookie. Use a fresh random 64-hex value per deployment.
MONITOR_SESSION_SECRET=

# Optional extra operator login (more logins can live in data/users.json)
MONITOR_AUTH_EMAIL=
MONITOR_AUTH_PASSWORD=

# Seconds between MT5 position polls per monitored client (1-300). 5 is a sensible default.
MONITOR_POLL_INTERVAL_SECONDS=5

# Web server bind address/port (Caddy proxies to this; never expose directly)
HOST=127.0.0.1
PORT=3000

# Where brokers/users/alerts/encryption.key are stored. Defaults to <project>/data.
# DATA_DIR=C:\apps\mt5-monitor\data

# Telegram alerts (can also be set in the web UI under Settings, which saves data/telegram.json)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Only needed to trigger polls externally via POST /api/alerts/poll (header X-Monitor-Poll-Secret)
# MONITOR_POLL_SECRET=
